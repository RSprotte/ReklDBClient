                    FontSize =11
                    Name ="Mastertab#Kategorie-Status"
                    RowSourceType ="Table/Query"
                    RowSource ="SELECT [Kategorien-Vorgangstatus_1].[Kategorie-Vorgangstatus], [Kategorien-Vorga"
                        "ngstatus_1].Anzeige FROM ([Kategorien-Vorgangstatus] INNER JOIN tblFolgeStatusAb"
                        "hängig ON [Kategorien-Vorgangstatus].ID = tblFolgeStatusAbhängig.IDAktiveStatus)"
                        " INNER JOIN [Kategorien-Vorgangstatus] AS [Kategorien-Vorgangstatus_1] ON tblFol"
                        "geStatusAbhängig.IDFolgeStatus = [Kategorien-Vorgangstatus_1].ID WHERE (((tblFol"
                        "geStatusAbhängig.IDVorgangsTyp)=Forms![Fehlererfassung - Register]![ReklMemo#Vor"
                        "gangstypID#1]) And (([Kategorien-Vorgangstatus].Anzeige)=Forms![Fehlererfassung "
                        "- Register]!txtAktiverStatus.value)) GROUP BY [Kategorien-Vorgangstatus_1].[Kate"
                        "gorie-Vorgangstatus], [Kategorien-Vorgangstatus_1].Anzeige; "
                    ColumnWidths ="0"
                    AfterUpdate ="[Event Procedure]"
                    FontName ="Arial"
                    OnMouseDown ="[Event Procedure]"
