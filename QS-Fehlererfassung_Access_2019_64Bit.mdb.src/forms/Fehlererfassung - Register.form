                                    RowSourceType ="Table/Query"
                                    RowSource ="SELECT Mastertab.ID, Sachbearbeiter.Bereich, Sum(AufwandVorgangPositionen.Zeit) "
                                        "AS SummevonZeit FROM (Mastertab LEFT JOIN AufwandVorgangPositionen ON Mastertab."
                                        "ID = AufwandVorgangPositionen.MID) LEFT JOIN Sachbearbeiter ON AufwandVorgangPos"
                                        "itionen.Kürzel = Sachbearbeiter.Kurzzeichen WHERE (((Mastertab.extern)=True) AND"
                                        " ((Sachbearbeiter.Aktiv)=True)) GROUP BY Mastertab.ID, Sachbearbeiter.Bereich HA"
                                        "VING (((Mastertab.ID)=[Formulare]![Fehlererfassung - Register]![Mastertab#ID]));"
                                        " "
