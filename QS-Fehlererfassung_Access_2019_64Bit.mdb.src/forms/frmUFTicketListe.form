    RecordSource ="SELECT tblTicketListe.ReklID, tblTicketTyp.Anzeige, tblTicketStatus.Anzeige, tbl"
        "TicketListe.MailDatum, tblTicketListe.BearbeitungBis, tblTicketListe.VerlängertB"
        "is, tblTicketListe.ErledigtAm, tblTicketListe.TicketID, tblTicketListe.TicketSta"
        "tusID, tblTicketListe.MailErstellt, tblTicketListe.TicketTypID, tblTicketListe.M"
        "ailAn, tblTicketListe.ErledigtVon, tblTicketTyp.TicketAnzeigen FROM (tblTicketLi"
        "ste LEFT JOIN tblTicketTyp ON tblTicketListe.TicketTypID = tblTicketTyp.TicketTy"
        "pID) LEFT JOIN tblTicketStatus ON tblTicketListe.TicketStatusID = tblTicketStatu"
        "s.TicketStatusID WHERE (((tblTicketStatus.TicketStatusID)<>3) AND ((tblTicketTyp"
        ".TicketAnzeigen)=True));"
