    RecordSource ="SELECT Maßnahmen.MaßnahmeID, Maßnahmen.Maßnahme, Maßnahmen.Beschreibung, Maßnahm"
        "en.[Ziel der Maßnahme], Maßnahmen.[Ergebnis Maßnahme], Maßnahmen.StartUmsetzung,"
        " Maßnahmen.EndeUmsetzung, Maßnahmen.UmgesetztAm, Maßnahmen.Priorität, Maßnahmen."
        "MaßnahmenHerkunftID, MaßnahmenHerkunft.Anzeige, Maßnahmen.Verantwortlich, Sachbe"
        "arbeiter.Kurzzeichen, Maßnahmen.ArtDerMaßnahme, MaßnahmeUmsetzungFrist.[ID-Umset"
        "zungMaßnahme], MaßnahmeUmsetzungFrist.Anzeige FROM ((Maßnahmen LEFT JOIN Sachbea"
        "rbeiter ON Maßnahmen.Verantwortlich = Sachbearbeiter.[SB-ID]) LEFT JOIN Maßnahme"
        "nHerkunft ON Maßnahmen.MaßnahmenHerkunftID = MaßnahmenHerkunft.ID) LEFT JOIN Maß"
        "nahmeUmsetzungFrist ON Maßnahmen.ArtDerMaßnahme = MaßnahmeUmsetzungFrist.[ID-Ums"
        "etzungMaßnahme] GROUP BY Maßnahmen.MaßnahmeID, Maßnahmen.Maßnahme, Maßnahmen.Bes"
        "chreibung, Maßnahmen.[Ziel der Maßnahme], Maßnahmen.[Ergebnis Maßnahme], Maßnahm"
        "en.StartUmsetzung, Maßnahmen.EndeUmsetzung, Maßnahmen.UmgesetztAm, Maßnahmen.Pri"
        "orität, Maßnahmen.MaßnahmenHerkunftID, MaßnahmenHerkunft.Anzeige, Maßnahmen.Vera"
        "ntwortlich, Sachbearbeiter.Kurzzeichen, Maßnahmen.ArtDerMaßnahme, MaßnahmeUmsetz"
        "ungFrist.[ID-UmsetzungMaßnahme], MaßnahmeUmsetzungFrist.Anzeige ORDER BY Maßnahm"
        "en.MaßnahmeID DESC; "
    Caption ="Maßnahmen"
    OnOpen ="[Event Procedure]"
    OnClose ="[Event Procedure]"
