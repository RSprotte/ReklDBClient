    RecordSource ="SELECT Mastertab.ID, Mastertab.[Meldungsnummer Kunde], Mastertab.[Bestellnummer "
        "Kunde], Kunden.Kontaktperson, tblFirma.Firma_Name, [Baugruppen-avista_out].[LQ A"
        "rt-Nr], [Baugruppen-avista_out].[Kunden-Nr], [Artikel-all_avista_out].[LQ Art-Nr"
        "], [Artikel-all_avista_out].[Kd Mat-Nr], Mastertab.[WE-Datum], Mastertab.[Rückli"
        "efer-Menge] AS Menge, Last(tblLager.Lagerbezeichnung) AS Werk FROM ((((Kunden IN"
        "NER JOIN Mastertab ON Kunden.[Kunden-ID] = Mastertab.[Kunden-ID]) INNER JOIN tbl"
        "Firma ON Kunden.FirmaID = tblFirma.Firma_ID) LEFT JOIN [Artikel-all_avista_out] "
        "ON Mastertab.[Artikel-ID 1] = [Artikel-all_avista_out].[Artikel-ID]) LEFT JOIN ["
        "Baugruppen-avista_out] ON Mastertab.[Baugruppen-ID] = [Baugruppen-avista_out].[B"
        "augruppen-ID]) LEFT JOIN tblLager ON Mastertab.LQEinheitID = tblLager.LQEinheitI"
        "D WHERE (((Mastertab.[Umbau/Reparatur])=True) AND ((Mastertab.Auftragsdatum)>#1/"
        "1/2018#)) GROUP BY Mastertab.ID, Mastertab.[Meldungsnummer Kunde], Mastertab.[Be"
        "stellnummer Kunde], Kunden.Kontaktperson, tblFirma.Firma_Name, [Baugruppen-avist"
        "a_out].[LQ Art-Nr], [Baugruppen-avista_out].[Kunden-Nr], [Artikel-all_avista_out"
        "].[LQ Art-Nr], [Artikel-all_avista_out].[Kd Mat-Nr], Mastertab.[WE-Datum], Maste"
        "rtab.[Rückliefer-Menge] HAVING (((tblFirma.Firma_Name) Not Like \"LQCN\" And (tb"
        "lFirma.Firma_Name) Not Like \"LQUS\") AND ((Mastertab.[WE-Datum]) Is Null)); "
    DatasheetFontName ="Calibri"
